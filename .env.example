# ==========================================================================
# EPC AI Assistant — environment configuration
# Copy to `.env` and fill in.  NEVER commit the real `.env`.
# ==========================================================================

# --- Core -----------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000
TIME_ZONE=Asia/Phnom_Penh
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# Leave empty for SQLite (development default).
# postgres://user:password@localhost:5432/epc_ai
# mysql://user:password@localhost:3306/epc_ai
DATABASE_URL=
DB_CONN_MAX_AGE=60

# --- Cache (optional; falls back to in-process memory) --------------------
REDIS_URL=

# --- AI provider ----------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
# Point this at your reseller endpoint if you are not calling OpenAI directly.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT=60
# gpt-5-mini reasons before answering, so part of this budget is spent on
# hidden thinking. Too small a value and the model returns nothing at all.
OPENAI_MAX_OUTPUT_TOKENS=
# GPT-4o bills to its own OpenAI account. Blank falls back to OPENAI_API_KEY.
OPENAI_GPT4O_API_KEY=4096
AI_MAX_CONTEXT_MESSAGES=12
AI_VISION_ENABLED=True

# Sampling. 0.4 is deliberately below the 1.0 default: study answers should be
# accurate and repeatable rather than inventive, and a lower temperature also
# rambles less, which costs fewer output tokens for the same content.
# Reasoning models (the gpt-5 family, o-series) ignore these.
AI_TEMPERATURE=0.4
AI_PRESENCE_PENALTY=0.1
AI_FREQUENCY_PENALTY=0.2

# Tokens a student must hold before a request is attempted at all, so we never
# start a call that cannot be paid for. It has to sit at or below the
# low-balance warning threshold: a floor above it would refuse exactly the
# messages the warning says are still possible.
AI_MIN_REQUEST_TOKENS=50

# --- Anthropic (Claude) ---------------------------------------------------
# A separate vendor account with its own key and its own credit balance. This
# is the *provider* balance (real money at Anthropic); the tokens students hold
# are the application's own accounting and live in the database.
ANTHROPIC_API_KEY=
# Only set this for a proxy. Leave it commented out to use Anthropic's own
# endpoint — an empty value here is read by the SDK as 'no host'.
#ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT=60
ANTHROPIC_MAX_OUTPUT_TOKENS=4096

# --- Voice input ----------------------------------------------------------
# Transcription runs server-side so the spoken language is detected rather
# than chosen. Audio is billed per minute, converted to tokens at this rate.
AI_VOICE_ENABLED=True
# whisper-1 detects the spoken language itself and reports it, along with
# the true audio duration the charge is based on. gpt-4o-transcribe also
# works here and reports neither; it was measured as no more accurate.
AI_TRANSCRIBE_MODEL=whisper-1
AI_TRANSCRIBE_TOKENS_PER_MINUTE=1500
# Charged by the real length of the recording above this floor, not
# rounded up to a whole minute.
AI_TRANSCRIBE_MIN_SECONDS=3
AI_TRANSCRIBE_MAX_SECONDS=120

# --- Attachments ----------------------------------------------------------
UPLOAD_MAX_FILES_PER_MESSAGE=5
UPLOAD_MAX_DOCUMENT_BYTES=8388608
UPLOAD_MAX_TOTAL_BYTES=20971520

# --- Break glass ----------------------------------------------------------
# The console at /admin/ covers the whole administrative job. Turn this on
# only to reach Django's stock admin at /django-admin/ during an outage.
DJANGO_ADMIN_ENABLED=False

# --- Email / OTP ----------------------------------------------------------
# Gmail requires an App Password (not the account password).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=EPC AI Assistant <no-reply@example.com>

# --- Telegram bot ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_URL=
# A community group for announcements (optional): its id from the console
# after adding the bot ("-100…"), or @groupusername, and its invite link.
TELEGRAM_GROUP_ID=
TELEGRAM_GROUP_URL=

# --- Payments -------------------------------------------------------------
# Any provider left blank automatically falls back to manual-review checkout.
PAYMENT_MANUAL_REVIEW=True

ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
ABA_PAYWAY_CURRENCY=USD
ABA_PAYWAY_PAYMENT_OPTION=
# "0" asks for PayWay's full hosted page (needed on a QR-Payment-API profile).
ABA_PAYWAY_PAYMENT_GATE=0
# The expiry date on ABA's credential sheet, so the gateways page warns in time.
ABA_PAYWAY_KEY_EXPIRES=

# ACLEDA Bank — XPAY hosted payment page. From ACLEDA's "Credential (Production)
# Document": BASE_URL is its URL up to (not including) /XPAYConnectorServiceInterfaceImplV2.
ACLEDA_XPAY_BASE_URL=
ACLEDA_XPAY_MERCHANT_ID=
ACLEDA_XPAY_LOGIN_ID=
ACLEDA_XPAY_PASSWORD=
ACLEDA_XPAY_SECRET=
ACLEDA_XPAY_MERCHANT_NAME=
ACLEDA_XPAY_CURRENCY=USD

ACLEDA_KHQR_BAKONG_ID=
ACLEDA_KHQR_ACCOUNT_NAME=EPC AI ASSISTANT
ACLEDA_KHQR_CITY=Phnom Penh
ACLEDA_KHQR_ACCOUNT_NUMBER=
ACLEDA_KHQR_MERCHANT_ID=
ACLEDA_KHQR_CURRENCY=KHR
BAKONG_API_TOKEN=
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh

BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=
BINANCE_PAY_MERCHANT_ID=
BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com
BINANCE_PAY_CURRENCY=USDT

# Local gateway emulator for development (only works with DEBUG=True).
# True points ABA, ACLEDA/Bakong and Binance at /dev/payment-emulator/ with
# test keys, overriding the values above, so every flow can be clicked
# through end to end. Keep False in production.
PAYMENT_EMULATOR=False

# Re-check open orders (and expire stale ones) from ordinary page loads, at
# most once a minute on a background thread. Leave on unless a scheduler runs
# `python manage.py send_reminders` every few minutes.
PAYMENT_SWEEP_ON_REQUEST=True

# --- Uploads --------------------------------------------------------------
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_IMAGE_DIMENSION=2000

# --- Rate limits (max hits / window seconds) ------------------------------
RL_LOGIN_LIMIT=8
RL_LOGIN_WINDOW=300
RL_SIGNUP_LIMIT=5
RL_SIGNUP_WINDOW=3600
RL_OTP_SEND_LIMIT=5
RL_OTP_SEND_WINDOW=900
RL_OTP_VERIFY_LIMIT=10
RL_OTP_VERIFY_WINDOW=900
RL_AI_LIMIT=30
RL_AI_WINDOW=60
RL_RESET_LIMIT=5
RL_RESET_WINDOW=3600
RL_PAYMENT_LIMIT=10
RL_PAYMENT_WINDOW=600
RL_SEARCH_LIMIT=30
RL_SEARCH_WINDOW=60

# --- Branding -------------------------------------------------------------
BRAND_NAME=AI Assistant
BRAND_FULL_NAME=EPC AI Assistant
BRAND_ORG=EPC
BRAND_TAGLINE=Your study partner that never sleeps.
SUPPORT_EMAIL=support@example.com
SUPPORT_TELEGRAM=

# --- Production only ------------------------------------------------------
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Context ---------------------------------------------------------------
# The real limit on how much history is re-sent. A message count is a poor
# proxy for cost, so the window is sized in tokens and AI_MAX_CONTEXT_MESSAGES
# above is only a ceiling on how many rows are considered at all.
AI_CONTEXT_TOKEN_BUDGET=1200
AI_SUMMARY_REFRESH_AFTER=6
AI_SUMMARY_MAX_TOKENS=200

# --- Voice output ----------------------------------------------------------
# The voice model is multilingual and infers the language from the text, so an
# Urdu answer is read in Urdu without anything being told to expect it.
AI_SPEECH_ENABLED=True
AI_SPEECH_MODEL=gpt-4o-mini-tts
AI_SPEECH_VOICE=alloy
AI_SPEECH_TOKENS_PER_1K_CHARS=400
AI_SPEECH_MAX_CHARS=4000

# --- Image generation ------------------------------------------------------
# None of the three chat models draws, so a request for a picture is routed to
# a dedicated endpoint instead of refused. Billed per picture, converted to
# tokens here, and paid for out of the student's OpenAI wallet.
# Image generation vendors. The platform can draw with any one of these;
# which one is live is chosen in Admin > Settings > Image generation, and the
# key set there wins over the one here.
GEMINI_API_KEY=
GEMINI_BASE_URL=
STABILITY_API_KEY=
STABILITY_BASE_URL=
AI_IMAGE_ENABLED=True
AI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_SIZE=1024x1024
AI_IMAGE_QUALITY=medium
AI_IMAGE_TIMEOUT=180
# Per quality: a cheaper picture costs the student less. medium is the
# default because at low the model renders labels as gibberish, and a
# diagram nobody can read has to be asked for again.
AI_IMAGE_TOKENS_PER_IMAGE=1200
AI_IMAGE_TOKENS_LOW=350
AI_IMAGE_TOKENS_HIGH=4500

# --- Live answers -----------------------------------------------------------
# Answers stream word by word; the model call runs on its own thread so an
# answer still finishes if the tab closes. Needs a threaded server in
# production (gunicorn --worker-class gthread --threads 8, or waitress).
CHAT_STREAM_THREADED=True

# --- Search by meaning --------------------------------------------------------
# Defaults to OPENAI_API_KEY / OPENAI_BASE_URL. Rebuild the index after changing
# the model or dimensions: python manage.py index_embeddings --rebuild
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256

# --- Browser notifications (Web Push) ------------------------------------------
# python manage.py generate_vapid_keys   — prints these three lines.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
